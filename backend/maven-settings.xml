<?xml version="1.0" encoding="UTF-8"?>
<!--
  Used only by the Docker build (see Dockerfile). Maven Central often answers Render's shared
  build machines with "429 Too Many Requests", so the build downloads from Google's mirror of
  Maven Central instead (same files). Local builds (./mvnw verify) don't use this file.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>Google mirror of Maven Central</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>